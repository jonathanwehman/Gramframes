<Ui xmlns="http://www.blizzard.com/wow/ui/">
    <!-- Raid member button (spawned by the secure group header) -->
    <Button name="GramFramesUnitButtonTemplate" inherits="SecureUnitButtonTemplate" virtual="true">
        <Size x="92" y="44"/>
        <Scripts>
            <OnLoad>GramFrames.InitUnitButton(self)</OnLoad>
        </Scripts>
    </Button>

    <!-- Tank panel button: the tank, plus a click-to-target button for whatever the tank is hitting -->
    <Button name="GramFramesTankButtonTemplate" inherits="SecureUnitButtonTemplate" virtual="true">
        <Size x="120" y="40"/>
        <Frames>
            <Button name="$parentTarget" parentKey="targetButton" inherits="SecureUnitButtonTemplate">
                <Size x="110" y="40"/>
                <Anchors>
                    <Anchor point="LEFT" relativePoint="RIGHT" x="4" y="0"/>
                </Anchors>
                <Attributes>
                    <Attribute name="useparent-unit" type="boolean" value="true"/>
                    <Attribute name="unitsuffix" type="string" value="target"/>
                    <Attribute name="type1" type="string" value="target"/>
                    <Attribute name="type2" type="string" value="togglemenu"/>
                </Attributes>
                <Scripts>
                    <OnLoad>GramFrames.InitTankTargetButton(self)</OnLoad>
                </Scripts>
            </Button>
        </Frames>
        <Scripts>
            <OnLoad>GramFrames.InitUnitButton(self, true)</OnLoad>
        </Scripts>
    </Button>
</Ui>
